<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RELight.App</RootNamespace>
    <Platforms>x64;arm64</Platforms>
    <!-- Keep the default desktop build x64, but make -r win-arm64 and
         -p:Platform=arm64 produce a native ARM64 apphost. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <ShouldComputeInputPris>false</ShouldComputeInputPris>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\RELight.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RELight.Core\RELight.Core.csproj" />
    <ProjectReference Include="..\RELight.Media\RELight.Media.csproj" />
    <ProjectReference Include="..\RELight.Audio\RELight.Audio.csproj" />
    <ProjectReference Include="..\RELight.Show\RELight.Show.csproj" />
    <ProjectReference Include="..\RELight.Studio\RELight.Studio.csproj" />
    <ProjectReference Include="..\RELight.Windows\RELight.Windows.csproj" />
  </ItemGroup>

</Project>
