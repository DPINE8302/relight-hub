{
  "name": "relight-vaping-education",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-offline.mjs && next build",
    "build:vercel": "npm run build",
    "qr": "node scripts/generate-qr.mjs",
    "start": "next start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
